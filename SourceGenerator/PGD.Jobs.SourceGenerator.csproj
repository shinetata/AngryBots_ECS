<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- 禁用增量生成器警告，因为 Roslyn 3.8 对 ISourceGenerator 的支持是标准的 -->
    <NoWarn>$(NoWarn);RS1035;RS1036;RS1038</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Source Generator 核心依赖 -->
    <PackageReference Include="Microsoft.CodeAnalysis" Version="3.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="3.8.0" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.8.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 防止生成器本身被打包 -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>

